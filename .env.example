# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# 1. NASA Open APIs Key (defaults to NASA's official keyless/free DEMO_KEY)
NASA_API_KEY="DEMO_KEY"

# 2. Optional: NASA Earthdata Bearer Token for restricted NSIDC / MERRA-2 / LPDAAC downloads.
# Public CMR discovery, NSIDC catalog search, and NASA POWER MERRA-2 climatology require NO paid key.
NASA_EARTHDATA_TOKEN=""

# 3. Optional: NCBI E-utilities API key for higher PubMed rate limits (10 req/s vs 3 req/s free).
# Obtain free key at https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=""

# 4. Optional: OpenTopography API key for 30m COP30 finite-difference DEM (free academic/dev key).
# Request at https://portal.opentopography.org/ — falls back cleanly to keyless Copernicus GLO-90.
OPENTOPOGRAPHY_API_KEY=""
